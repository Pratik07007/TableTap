generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String      @id @default(uuid())
  firstName       String
  lastName        String
  email           String      @unique
  hash            String
  role            Role
  isEmailVerified Boolean     @default(false)
  resturant       Resturants? @relation("UserOwnsRestaurant")

  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
  processedBills Bill[]   @relation("UserProcessedBills")
}

model Resturants {
  id            String  @id @default(uuid())
  name          String
  streetAddress String
  city          String
  state         String
  zip           String
  country       String
  phone         String
  email         String  @unique
  faceBookUrl   String?
  tikTokUrl     String?
  instagramUrl  String?

  userId String @unique
  owner  User   @relation("UserOwnsRestaurant", fields: [userId], references: [id])

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

enum Role {
  USER
  ADMIN
}

model MenuItem {
  id          String  @id @default(uuid())
  name        String
  description String?
  unit        Unit[]
  imageUrl    String?
  isAvailable Boolean @default(true)

  resturantID String
  restaurant  Resturants @relation(fields: [resturantID], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  menuCategory Category    @relation(fields: [categoryId], references: [id])
  categoryId   String
  orderItems   OrderItem[]
}

model Unit {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  unit       String
  price      Float
}

model Category {
  id        String     @id @default(uuid())
  category  String
  menuItems MenuItem[]
}

model Order {
  id          String      @id @default(uuid())
  totalAmount Float
  discount    Float       @default(0)
  finalAmount Float
  status      OrderStatus @default(PENDING)
  isPaid      Boolean     @default(false)
  paidAt      DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  customerEmail String?

  resturantID String?
  restaurant  Resturants? @relation(fields: [resturantID], references: [id])

  items OrderItem[]

  bill Bill?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  unitName String // Snapshot of the unit name (e.g., "Full")
  price    Float // Snapshot of the price per unit
  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  COOKING
  READY
  COMPLETED
  CANCELLED
}

model Bill {
  id         String @id @default(uuid())
  billNumber Int    @unique @default(autoincrement())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  totalAmount          Float
  paymentStatus        PaymentStatus  @default(PENDING)
  paymentMethod        PaymentMethod?
  amountTendered       Float?
  changeGiven          Float?
  paidAt               DateTime?
  transactionId        String?
  paymentProcessedById String?
  paymentProcessedBy   User?          @relation("UserProcessedBills", fields: [paymentProcessedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  CASH
  ONLINE
}
