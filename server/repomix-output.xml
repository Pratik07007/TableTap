<file path="src/utils/emailRetry.ts">
export const sendWithRetry = async <T>(fn: () => Promise<T>, attempts: number = 3, delayMs: number = 500) => {
  let lastError: unknown;
  for (let i = 0; i < attempts; i += 1) {
    try {
      return await fn();
    } catch (error) {
      lastError = error;
      if (i < attempts - 1) {
        await new Promise((resolve) => setTimeout(resolve, delayMs * (i + 1)));
      }
    }
  }
  throw lastError;
};
</file>

